# Copy to `.env` (git-ignored) and fill in. Real environment variables win over
# this file, so `AI_API_KEY=… npm start` still overrides it.

# Set a strong password; when omitted, a temporary random password is printed at startup.
DASHBOARD_PASSWORD=

# Optional: real AI drafting and custom bots through ANY OpenAI-compatible
# provider (FreeLLMAPI, OpenRouter, Groq, a local vLLM/Ollama, or OpenAI).
# Leave blank to keep labeled template drafts.
AI_BASE_URL=http://127.0.0.1:3001/v1
AI_API_KEY=
# Prefer a specific, fast, non-reasoning model for multi-bot runs. A router's
# "auto" often picks heavy reasoning models that exceed the timeout and leak
# chain-of-thought into the output.
AI_MODEL=laguna-xs-2.1
# "chat" uses /v1/chat/completions, "responses" uses OpenAI's /v1/responses.
# Inferred from AI_BASE_URL when blank (OpenAI host -> responses, else chat).
AI_API_STYLE=
# Free-tier routing can be slow; request budget in milliseconds.
AI_TIMEOUT_MS=180000
# How many model calls may run at once; more are refused, not queued.
AI_MAX_CONCURRENCY=4

# For OpenAI itself: unset AI_BASE_URL (defaults to https://api.openai.com/v1)
# and set AI_API_KEY (or OPENAI_API_KEY) plus AI_MODEL (e.g. gpt-4.1-mini).

HOST=127.0.0.1
PORT=4173
# JSON sibling path (default data/state.json). SQLite is the same name with .db,
# or set DATA_DB. STORE_BACKEND=json forces the legacy JSON store.
# DATA_FILE=
# DATA_DB=
# STORE_BACKEND=
# Optional for fixed external HTTPS URLs behind a reverse proxy.
PUBLIC_ORIGIN=

# Contact that push services (Apple, Google, Mozilla) are shown for this
# server: mailto:you@example.com or an https URL. Defaults to PUBLIC_ORIGIN.
VAPID_SUBJECT=

# Webhook notifications are not sent to private or local addresses.
# Set to 1 only for a relay on your own network.
WEBHOOK_ALLOW_PRIVATE=

# Email channel POSTs JSON {to,title,body,meta,at} to this HTTP(S) gateway.
# Set EMAIL_RELAY_TOKEN only when the gateway uses HTTPS.
# This app does not speak SMTP. Unset, delivery fails instead of claiming sent.
# EMAIL_RELAY_URL=
# EMAIL_RELAY_TOKEN=

# Optional in-process HTTPS. Both must be set. A reverse proxy is the usual path.
# TLS_CERT=
# TLS_KEY=

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
# TRUST_PROXY=

# Hosted installs: 0 so password-reset tokens are not printed to the process log.
# RESET_TOKEN_CONSOLE=

# HSTS=1 only after HTTPS works.
# HSTS=

# 32-byte vault key (64 hex chars). Else a 0600 keyfile is created beside the DB.
# MASTER_KEY=

# Local agent (`node agent/agent.mjs`). These are read by the device process,
# not the dashboard. See docs/AGENT-PROTOCOL.md.
# AGENT_BROWSER=1
# AGENT_BROWSER_PATH=
# AGENT_BROWSER_ARGS=
# AGENT_BROWSER_ALLOWLIST=x.com,docs.example.com
# AGENT_BROWSER_PROFILE=
# AGENT_ALLOW_PRIVATE=
# AGENT_POLL_MS=15000
# AGENT_CONFIG=
