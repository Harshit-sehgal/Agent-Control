# Copy to `.env` (git-ignored) and fill in. Real environment variables win over
# this file, so `AI_API_KEY=… npm start` still overrides it.

# Set a strong password; when omitted, a temporary random password is printed at startup.
DASHBOARD_PASSWORD=

# Optional: real AI drafting and custom bots through ANY provider — an
# OpenAI-compatible endpoint (OpenRouter, Groq, FreeLLMAPI, a local vLLM/Ollama,
# OpenAI), OpenAI's Responses API, Anthropic's Messages API, Google Gemini, or
# Azure OpenAI. Leave blank to keep labeled template drafts. Providers can also
# be added at run time under You -> AI and models; these variables are the
# fallback.
AI_BASE_URL=http://127.0.0.1:3001/v1
AI_API_KEY=
# Prefer a specific, fast, non-reasoning model for multi-bot runs. A router's
# "auto" often picks heavy reasoning models that exceed the timeout and leak
# chain-of-thought into the output.
AI_MODEL=laguna-xs-2.1
# Wire protocol. "chat" uses {base}/chat/completions, "responses" uses OpenAI's
# /responses, "anthropic" uses Claude's /messages, "gemini" uses Google's
# models/{model}:generateContent, "azure" uses
# {base}/openai/deployments/{deployment}/chat/completions?api-version=
# Aliases: messages|claude -> anthropic, google -> gemini, openai|compatible ->
# chat. Blank infers it from AI_BASE_URL's host (api.anthropic.com -> anthropic,
# generativelanguage.googleapis.com -> gemini, *.openai.azure.com -> azure,
# api.openai.com -> responses, anything else -> chat).
AI_API_STYLE=
# Free-tier routing can be slow; request budget in milliseconds.
AI_TIMEOUT_MS=180000
# How many model calls may run at once; more are refused, not queued.
AI_MAX_CONCURRENCY=4

# For OpenAI itself: unset AI_BASE_URL (defaults to https://api.openai.com/v1)
# and set AI_API_KEY (or OPENAI_API_KEY) plus AI_MODEL (e.g. gpt-4.1-mini).
# OPENAI_BASE_URL and OPENAI_MODEL are the older names for AI_BASE_URL and
# AI_MODEL.

# Alternative keys, used in place of AI_API_KEY. With no base URL set, a key
# here also chooses the endpoint: ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
# alone points at https://api.anthropic.com/v1, GEMINI_API_KEY or
# GOOGLE_GENAI_API_KEY alone at https://generativelanguage.googleapis.com/v1beta
# (GOOGLE_API_KEY is the older name). ANTHROPIC_BASE_URL sets the endpoint.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=

# OPTIONAL: Azure OpenAI. Needs the resource endpoint (its host selects the
# "azure" protocol), and the model id is the deployment name. A bare Azure key
# picks no endpoint of its own.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

HOST=127.0.0.1
PORT=4173
# JSON sibling path (default data/state.json); the SQLite file is the same name
# with .db, or set DATA_DB. A state.json written by 0.6 is imported once and left
# beside the database; there is no other store to switch to.
# DATA_FILE=
# DATA_DB=
# Optional for fixed external HTTPS URLs behind a reverse proxy.
PUBLIC_ORIGIN=

# Contact that push services (Apple, Google, Mozilla) are shown for this
# server: mailto:you@example.com or an https URL. Defaults to PUBLIC_ORIGIN.
VAPID_SUBJECT=

# Webhook notifications are not sent to private or local addresses.
# Set to 1 only for a relay on your own network.
WEBHOOK_ALLOW_PRIVATE=

# Email channel. Set a mailbox and the app speaks SMTP itself; 587 submits with
# STARTTLS, 465 (SMTP_SECURE=1) is TLS from the first byte.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Agent Control <agent@example.com>"
# 1 = TLS from connect (port 465). 465 and 587 both verify the certificate.
# SMTP_SECURE=
# A server offering no STARTTLS is an error, not a downgrade: 0 allows it, and
# is only right for a relay on your own network.
# SMTP_REQUIRE_TLS=
# SMTP_TIMEOUT_MS=

# Alternative email channel: POST JSON {to,title,body,meta,at} to this HTTP(S)
# gateway instead of a mailbox. Set EMAIL_RELAY_TOKEN only when it uses HTTPS.
# SMTP_HOST wins when both are set. With neither, delivery fails instead of
# claiming the message was sent.
# EMAIL_RELAY_URL=
# EMAIL_RELAY_TOKEN=

# Optional in-process HTTPS. Both must be set. A reverse proxy is the usual path.
# TLS_CERT=
# TLS_KEY=

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For /
# X-Forwarded-Proto. Sign-in is limited per client address and per account; the
# address is the rightmost X-Forwarded-For hop, the one the proxy wrote.
# TRUST_PROXY=

# Hosted installs: 0 so password-reset tokens are not printed to the process log.
# RESET_TOKEN_CONSOLE=

# HSTS=1 only after HTTPS works.
# HSTS=

# 32-byte vault key (64 hex chars). Else a 0600 keyfile is created beside the DB.
# MASTER_KEY=

# Local agent (`node agent/agent.mjs`). These are read by the device process,
# not the dashboard. See docs/AGENT-PROTOCOL.md.
# AGENT_BROWSER=1
# AGENT_BROWSER_PATH=
# AGENT_BROWSER_ARGS=
# AGENT_BROWSER_ALLOWLIST=x.com,docs.example.com
# AGENT_BROWSER_PROFILE=
# AGENT_ALLOW_PRIVATE=
# AGENT_POLL_MS=15000
# AGENT_CONFIG=
