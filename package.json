{
  "name": "agent-control-prototype",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local-first multi-agent dashboard with human-approved X drafting and browser capture",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "test": "node --experimental-sqlite --test tests/*.test.js",
    "test:coverage": "node --experimental-sqlite --test --experimental-test-coverage tests/*.test.js",
    "build:pages": "node scripts/build-pages.js",
    "check": "node scripts/check.mjs",
    "backup": "node --experimental-sqlite scripts/backup.mjs",
    "test:e2e": "python3 tests/live_smoke.py",
    "test:ui": "python3 tests/polish_smoke.py && python3 tests/usability_smoke.py"
  }
}
