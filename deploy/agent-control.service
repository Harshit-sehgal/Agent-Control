# systemd unit for a host without Docker.
#
#   sudo useradd --system --home /srv/agent-control agent-control
#   sudo cp deploy/agent-control.service /etc/systemd/system/
#   sudo systemctl enable --now agent-control
#
# Put a reverse proxy that terminates HTTPS in front (see docs/DEPLOYMENT.md).
[Unit]
Description=Agent Control
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/srv/agent-control
EnvironmentFile=/srv/agent-control/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
User=agent-control
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/agent-control/data

[Install]
WantedBy=multi-user.target
