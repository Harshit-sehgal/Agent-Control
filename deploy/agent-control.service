# Agent Control as a systemd service (no Docker needed).
#   sudo cp deploy/agent-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agent-control
# Adjust WorkingDirectory/EnvironmentFile and the User to your install.
[Unit]
Description=Agent Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-control
WorkingDirectory=/srv/agent-control
EnvironmentFile=/srv/agent-control/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
# Hardening: the app only writes under data/ (SQLite + vault keyfile).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/agent-control/data

[Install]
WantedBy=multi-user.target
