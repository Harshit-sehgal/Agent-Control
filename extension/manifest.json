{
  "manifest_version": 3,
  "name": "Agent Control — Capture",
  "description": "Capture one user-selected browser post for AI drafting. No automated scrolling or posting.",
  "version": "0.7.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_title": "Capture visible post", "default_popup": "popup.html"}
}
